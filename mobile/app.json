{
  "expo": {
    "name": "SINTERA",
    "slug": "sintera",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sintera",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sintera.app"
    },
    "android": {
      "package": "com.sintera.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "A SINTERA usa a galeria para você enviar laudos e receitas." }
      ],
      [
        "expo-camera",
        { "cameraPermission": "A SINTERA usa a câmera para você fotografar laudos e receitas." }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
