# Ambiente do app móvel SINTERA (Passo 6 — cliente de API). Preencher no ambiente de dev.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endereço da Web — PONTE ADR-020. Sem ele, o aplicativo perde EM SILÊNCIO tudo que depende de rota da Web:
# classificação de documento (leitura assistida), Conexões, análise de exame, ômicas e exportação de conta.
# As funções devolvem `null` de propósito (leitura assistida é auxílio, não requisito), então a ausência não
# aparece como erro — só como nada acontecendo. Foi o que aconteceu na homologação de 27/08.
# Nas builds da EAS o valor vem do `eas.json` (é URL pública, não segredo). Aqui, para rodar local.
EXPO_PUBLIC_WEB_URL=https://sinteramais.com.br
