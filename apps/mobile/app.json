{
  "expo": {
    "name": "SINTERA",
    "slug": "sintera",
    "scheme": "sintera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#488593"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "health.sintera.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": ["pt-BR"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Protege o acesso aos seus dados de saúde neste aparelho."
      }
    },
    "android": {
      "package": "health.sintera.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3D6C7B"
      },
      "permissions": [
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite anexar imagens de exames da sua galeria.",
          "cameraPermission": "Permite fotografar o documento do seu exame."
        }
      ],
      "./plugins/withAndroidCmakeVersion",
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      "./plugins/withHealthConnectRationale",
      "./plugins/withMinSdkOverride",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "366cec46-5431-4601-9b2d-5f685f96d8bc"
      }
    },
    "owner": "sintera-health-tech"
  }
}
