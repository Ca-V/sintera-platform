{
  "expo": {
    "name": "SINTERA",
    "slug": "sintera",
    "scheme": "sintera",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "health.sintera.app"
    },
    "android": {
      "package": "health.sintera.app"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite anexar imagens de exames da sua galeria.",
          "cameraPermission": "Permite fotografar o documento do seu exame."
        }
      ],
      "./plugins/withAndroidCmakeVersion",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "366cec46-5431-4601-9b2d-5f685f96d8bc"
      }
    },
    "owner": "sintera-health-tech"
  }
}
